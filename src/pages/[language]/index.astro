---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  const languages = [...new Set(entries.map(({ id }) => id.split('/')[0]))];
  return languages.map((language) => {
    const first = entries
      .filter(({ id }) => id.startsWith(`${language}/`))
      .sort((a, b) => a.data.order - b.data.order)[0];
    return { params: { language }, props: { destination: `/${first.id}/` } };
  });
}

const { destination } = Astro.props;
---
<!doctype html>
<html><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0;url=${destination}`} /></head></html>
