---
interface Props {
  kind: string;
  label: string;
  title?: string;
  wide?: boolean;
  variantClass?: string;
}
const { kind, label, title, wide = false, variantClass } = Astro.props;
---
<aside class:list={['knowledge-card', `knowledge-card--${kind}`, variantClass, { 'is-wide': wide }]}>
  <header>
    <span class="knowledge-card__label">{label}</span>
    {title && <h3>{title}</h3>}
  </header>
  <div class="knowledge-card__content"><slot /></div>
</aside>
